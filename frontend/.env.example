# ClientPulse frontend — copy to .env.local
# The frontend uses Supabase only for Auth. Application data is fetched through
# the authenticated FastAPI backend; never expose the service-role key here.

VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
