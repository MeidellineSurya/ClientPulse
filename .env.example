# ClientPulse — root environment reference
# This file lists every env var used across the monorepo, for reference only.
# Each app also has its own .env.example (frontend/.env.example, backend/.env.example) —
# copy those into frontend/.env.local and backend/.env respectively.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google (Gmail metadata + Calendar pull, stretch goal) ---
# GOOGLE_REFRESH_TOKEN must be granted with metadata-only Gmail scope
# (gmail.metadata) and read-only Calendar scope (calendar.readonly) only —
# never gmail.readonly, since message bodies must never be read.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
