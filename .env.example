# ClientPulse — root environment reference
# This file lists every env var used across the monorepo, for reference only.
# Each app also has its own .env.example (frontend/.env.example, backend/.env.example) —
# copy those into frontend/.env.local and backend/.env respectively.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google (production Gmail metadata + Calendar ingestion) ---
# GOOGLE_REFRESH_TOKEN must be granted exactly gmail.metadata and
# calendar.readonly. Any broader scopes Google reports are rejected; the code
# path itself only performs metadata-only and read-only API operations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (React/Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
