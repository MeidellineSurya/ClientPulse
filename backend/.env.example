# ClientPulse backend — copy to .env

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Google (production Gmail metadata + Calendar ingestion) ---
# OAuth2 credentials for the agency's own connected mailbox/calendar.
# GOOGLE_REFRESH_TOKEN must be granted exactly the metadata-only Gmail scope
# (https://www.googleapis.com/auth/gmail.metadata) and read-only Calendar
# scope (https://www.googleapis.com/auth/calendar.readonly). Any broader scope
# reported by Google is rejected; this path only calls read operations.
GOOGLE_AGENCY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
