# ClientPulse backend — copy to .env

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Google (Gmail metadata + Calendar pull, stretch goal) ---
# OAuth2 credentials for the agency's own connected mailbox/calendar.
# GOOGLE_REFRESH_TOKEN must have been granted with metadata-only Gmail scope
# (https://www.googleapis.com/auth/gmail.metadata) and read-only Calendar
# scope (https://www.googleapis.com/auth/calendar.readonly) — never the
# full gmail.readonly scope, since we must never read message bodies.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
